{
  "manifest_version": 3,
  "name": "navbro",
  "version": "0.0.10-snapshot",
  "description": "Small keyboard-first Vim-like browsing extension for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "navbro@dector.space",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "sessions",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "key-config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
